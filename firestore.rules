rules_version = '2';

// Security rules for Shop Manager (made by Greenlight Stationeries).
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Who can do what:
//   management – creates shops, assigns owners, sees every shop (platform/admins)
//   owner      – everything in their shop, including adding managers and sellers
//   manager    – everything in their shop except managing people
//   staff      – ("Seller" in the app) record sales and view stock only
// Anyone else is refused, even if they find the web address.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function adminsPath() {
      return /databases/$(database)/documents/platform/admins;
    }
    function isAdmin() {
      return signedIn() && exists(adminsPath()) && get(adminsPath()).data.admins.get(myEmail(), false) == true;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Management ----------
    match /platform/admins {
      allow read: if signedIn();
      // The very first person to set up becomes management — or, if a single shop
      // already exists from before, only that shop's owner can.
      allow create: if signedIn() && !exists(adminsPath())
        && request.resource.data.admins.keys().hasOnly([myEmail()])
        && request.resource.data.admins[myEmail()] == true
        && (!exists(/databases/$(database)/documents/meta/access)
            || get(/databases/$(database)/documents/meta/access).data.owner == request.auth.uid);
      // Management can add others, but cannot remove themselves.
      allow update: if isAdmin() && request.resource.data.admins.get(myEmail(), false) == true;
      allow delete: if false;
    }

    // ---------- Shops ----------
    match /shops/{shopId} {
      function shop() {
        return get(/databases/$(database)/documents/shops/$(shopId)).data;
      }
      function role() {
        return isAdmin() ? 'owner'
          : (myEmail() in shop().owners ? 'owner' : shop().members.get(myEmail(), 'none'));
      }
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/shops/$(shopId)) && role() != 'none';
      }
      function isBoss() {
        return isMember() && role() in ['owner', 'manager'];
      }
      // Delete received orders, clear losses, delete expenses: owners, and managers the owner has allowed.
      function canClear() {
        return isMember() && (role() == 'owner'
          || (role() == 'manager' && shop().get('canClear', {}).get(myEmail(), false) == true));
      }
      function sellersReceive() {
        return isMember() && get(/databases/$(database)/documents/shops/$(shopId)/meta/settings).data.get('staffCanReceive', false) == true;
      }

      // The shop itself: name, owners, members.
      allow read: if isAdmin() || (signedIn() && myEmail() in resource.data.memberEmails);
      allow create: if isAdmin();
      // Owners manage managers and sellers; only management changes owners.
      allow update: if isAdmin()
        || (signedIn() && myEmail() in resource.data.owners
            && request.resource.data.owners == resource.data.owners);
      allow delete: if false;

      match /meta/settings {
        allow read: if isMember();
        allow write: if isBoss();
      }

      match /items/{id} {
        allow read: if isMember();
        allow create, delete: if isBoss();
        // Sellers may only change stock levels (when they record a sale or receive a delivery).
        allow update: if isBoss()
          || (isMember() && onlyChanges(['stock', 'updatedAt']))
          || (sellersReceive() && onlyChanges(['stock', 'updatedAt', 'cost', 'lastCost', 'updatedBy']));
      }

      match /sales/{id} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.by == myEmail();
        allow update: if isBoss();      // cancelling a sale
        allow delete: if role() == 'owner';
      }

      match /pos/{id} {
        allow read: if isMember();
        allow create: if isBoss();
        // Orders with nothing received yet: owners and managers. Partly/fully received: canClear only.
        allow delete: if (isBoss() && resource.data.status in ['draft', 'ordered', 'cancelled']) || canClear();
        allow update: if isBoss()
          || (sellersReceive() && onlyChanges(['lines', 'status', 'closedShort', 'receivedAt', 'updatedAt', 'updatedBy']));
      }

      match /purchases/{id} {
        allow read: if isMember();
        allow create: if isBoss() || sellersReceive();
        allow update: if isBoss();
        allow delete: if canClear();   // undoing a received order
      }

      // Change history: anyone working in the shop records what they changed; undoing needs canClear.
      match /changes/{id} {
        allow read: if isBoss();
        allow create: if isMember() && request.resource.data.by == myEmail();
        allow update: if canClear() && onlyChanges(['undone', 'undoneAt', 'undoneBy']);
        allow delete: if false;
      }

      // Customers: sellers add them at the till and their credit sales change the balance.
      match /customers/{id} {
        allow read, create, update: if isMember();
        allow delete: if isBoss();
      }
      // Payments customers make on what they owe; shifts (cash drawer) opened by whoever is selling.
      match /payments/{id} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.by == myEmail();
        allow update, delete: if isBoss();
      }
      match /shifts/{id} {
        allow read, create: if isMember();
        allow update: if isBoss() || (isMember() && resource.data.by == myEmail());
        allow delete: if isBoss();
      }

      match /{col}/{id} {
        allow read: if isMember() && col in ['suppliers', 'rfqs', 'adjustments', 'expenses', 'quotes', 'invoices', 'closings'];
        allow create, update: if isBoss() && col in ['suppliers', 'rfqs', 'adjustments', 'expenses', 'quotes', 'invoices', 'closings'];
        // Clearing loss and expense figures needs canClear; the rest owners and managers.
        allow delete: if (col in ['adjustments', 'expenses'] && canClear())
          || (isBoss() && col in ['suppliers', 'rfqs', 'quotes', 'invoices', 'closings']);
      }
    }

    // ---------- Old single-shop layout (kept so it can be moved into shops/) ----------
    function legacyAccess() {
      return get(/databases/$(database)/documents/meta/access).data;
    }
    function legacyOwner() {
      return signedIn() && legacyAccess().owner == request.auth.uid;
    }
    match /meta/access {
      allow read: if signedIn() && (resource == null
        || resource.data.owner == request.auth.uid
        || myEmail() in resource.data.members);
      allow update: if legacyOwner()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.ownerEmail == resource.data.ownerEmail;
      allow create, delete: if false;
    }
    match /meta/settings {
      allow read: if legacyOwner();
      allow write: if false;
    }
    match /{col}/{id} {
      allow read: if legacyOwner() && col in ['items', 'suppliers', 'rfqs', 'pos', 'sales', 'purchases', 'adjustments', 'expenses'];
      allow write: if false;
    }
  }
}
